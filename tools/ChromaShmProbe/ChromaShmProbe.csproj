<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <Platforms>x64</Platforms>
        <PlatformTarget>x64</PlatformTarget>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <SelfContained>false</SelfContained>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AssemblyName>ChromaShmProbe</AssemblyName>
        <RootNamespace>ChromaShmProbe</RootNamespace>
        <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <!-- Reuse the official Chroma SDK binding from the emitter tool -->
        <Compile Include="..\ChromaEventEmitter\ChromaSdk.cs" Link="ChromaSdk.cs" />
    </ItemGroup>

</Project>
